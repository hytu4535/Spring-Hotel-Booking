<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>HotelBooking</display-name>

    <!-- Trang mac dinh -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session het han sau 30 phut -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Trang loi -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/access-denied.jsp</location>
    </error-page>

    <!--
        GHI CHU CHO NHOM:
        Cac Servlet va Filter deu dung Annotation (@WebServlet, @WebFilter)
        nen KHONG can khai bao mapping o day.
        File web.xml chi giu cau hinh chung: welcome-file, session, error-page.
    -->

</web-app>
